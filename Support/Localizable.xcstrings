    "Eşlenmiş tıklama jesti tetiklendiğinde tıklamanın kendisi uygulamaya gitmez. Eşlenmemişse tıklama normal çalışır." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird eine zugewiesene Klickgeste ausgelöst, erreicht der Klick selbst die App nicht. Ohne Zuweisung funktioniert der Klick wie gewohnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a mapped click gesture triggers, the click itself isn’t passed to the app. Unmapped clicks work normally."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se activa un gesto de clic asignado, el clic en sí no llega a la app. Si no está asignado, el clic funciona con normalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu’un geste de clic attribué se déclenche, le clic lui-même n’est pas transmis à l’app. Sinon, le clic fonctionne normalement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "割り当て済みのクリックジェスチャが作動すると、クリック自体はアプリに送られません。割り当てがない場合は通常どおりクリックできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已映射的点按手势触发时，点按本身不会传给应用。未映射时点按照常工作。"
          }
        }
      }
