    "Beş parmakla art arda iki kez dokun" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zweimal kurz nacheinander mit fünf Fingern tippen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap twice in quick succession with five fingers"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces seguidas con cinco dedos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois de suite avec cinq doigts"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5本指で2回続けてタップ"
