    "Yan eksendeki hareketin ana eksene oranı. Düşükse yalnızca düz kaydırmalar geçer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhältnis der Querbewegung zur Hauptachse. Bei niedrigem Wert zählen nur gerade Streichbewegungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratio of cross-axis to main-axis movement. Lower values allow only straight swipes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proporción entre el movimiento en el eje transversal y en el principal. Si es baja, solo se aceptan deslizamientos rectos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapport entre le mouvement transversal et le mouvement principal. Une valeur faible n’accepte que les balayages rectilignes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主方向の移動に対する横方向の移動の比率。低くすると、まっすぐなスワイプのみが認識されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "侧向移动与主方向移动之比。值越低，只有越笔直的轻扫才会被接受。"
          }
        }
      }
    },
