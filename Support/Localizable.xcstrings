    "Parmak uyumu" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fingerübereinstimmung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finger agreement"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concordancia de dedos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concordance des doigts"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指の一致度"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
