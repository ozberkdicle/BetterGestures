    "Dokunan parmak bundan uzun basılı kalırsa tetiklenmez." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt der tippende Finger länger aufgelegt, wird nichts ausgelöst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doesn’t trigger if the tapping finger stays down longer than this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se activa si el dedo que toca permanece apoyado más tiempo."
          }
        },
        "fr" : {
