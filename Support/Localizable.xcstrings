    "Bir parmak dururken sağına iki parmakla dokun" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Finger ruht, rechts daneben mit zwei Fingern tippen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With one finger resting, tap two fingers to its right"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un dedo apoyado, toca a su derecha con dos dedos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un doigt posé, touchez à sa droite avec deux doigts"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1本指を置いたまま、その右側を2本指でタップ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一指按住，在其右侧用两指轻点"
          }
        }
      }
    },
