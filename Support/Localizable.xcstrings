    "İki dokunuş arasındaki azami boşluk. Çift dokunma eşlenmişse tek dokunma bu kadar gecikir." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximaler Abstand zwischen zwei Tippbewegungen. Ist Doppeltippen zugewiesen, wird einfaches Tippen um diese Zeit verzögert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximum gap between two taps. If a double tap is mapped, single taps are delayed by this much."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo máximo entre dos toques. Si hay un doble toque asignado, el toque simple se retrasa este tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai maximal entre deux touchers. Si un double toucher est attribué, le toucher simple est retardé d’autant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2回のタップ間の最大間隔。ダブルタップを割り当てると、シングルタップはこの時間だけ遅れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两次轻点之间的最大间隔。如果映射了轻点两下，单次轻点会延迟这么久。"
          }
        }
      }
    },
    "İki parmak dururken sağına dokun" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Finger ruhen, rechts daneben tippen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With two fingers resting, tap to their right"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con dos dedos apoyados, toca a su derecha"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux doigts posés, touchez à leur droite"
          }
        },
        "ja" : {
          "stringUnit" : {
