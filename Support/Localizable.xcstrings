    "Bu pencere öndeyken kısayollar gönderilmez. Jestleri deneyin; tanınan satır yanar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange dieses Fenster vorne ist, werden keine Kurzbefehle gesendet. Probiere Gesten aus – die erkannte Zeile leuchtet auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcuts aren’t sent while this window is in front. Try a gesture; its row lights up when recognized."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras esta ventana está delante no se envían atajos. Prueba los gestos; la fila reconocida se ilumina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis ne sont pas envoyés tant que cette fenêtre est au premier plan. Essayez des gestes : la ligne reconnue s’allume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウインドウが前面にある間はショートカットは送信されません。ジェスチャを試すと、認識された行がハイライトされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此窗口位于最前面时不会发送快捷键。试试手势，识别出的行会高亮显示。"
          }
        }
      }
    },
