    },
    "İki parmakla TipTap'te ikinci parmak ilkinden en geç bu kadar sonra inmeli." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim TipTap mit zwei Fingern muss der zweite Finger spätestens so lange nach dem ersten aufsetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In two-finger TipTap, the second finger must land within this long after the first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el TipTap con dos dedos, el segundo dedo debe apoyarse como máximo este tiempo después del primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un TipTap à deux doigts, le second doigt doit se poser au plus tard ce délai après le premier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2本指のTipTapでは、2本目の指が1本目からこの時間以内に触れる必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双指 TipTap 中，第二个手指须在第一个手指落下后此时长内落下。"
          }
        }
      }
    },
    "İki parmakla dokunma aralığı" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervall für Tippen mit zwei Fingern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two-finger tap interval"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalo del toque con dos dedos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalle du toucher à deux doigts"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2本指タップの間隔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双指轻点间隔"
          }
        }
      }
    },
    "İkinci parmak inmeden önce ilki en az bu kadar basılı olmalı. İki parmakla birlikte dokunmayı (sağ tık) ayırt eder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Finger muss mindestens so lange aufliegen, bevor der zweite aufsetzt. Grenzt gegen gleichzeitiges Tippen mit zwei Fingern (Sekundärklick) ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first finger must be down at least this long before the second lands. Distinguishes TipTap from a two-finger tap (secondary click)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primer dedo debe estar apoyado al menos este tiempo antes de que se apoye el segundo. Así se distingue del toque simultáneo con dos dedos (clic secundario)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier doigt doit rester posé au moins ce délai avant que le second ne se pose. Permet de distinguer un toucher simultané à deux doigts (clic secondaire)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2本目の指が触れる前に、1本目の指がこの時間以上触れている必要があります。2本指の同時タップ(副ボタンのクリック)と区別するためです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第二个手指落下前，第一个手指须至少已按住此时长。用于区分双指同时轻点（辅助点按）。"
          }
        }
      }
    },
