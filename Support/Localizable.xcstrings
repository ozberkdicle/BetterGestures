    "Üç parmak bu kadar hareketsiz kalınca tetiklenir." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löst aus, wenn drei Finger so lange reglos bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triggers when three fingers stay still for this long."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se activa cuando tres dedos permanecen quietos este tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se déclenche lorsque trois doigts restent immobiles pendant cette durée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
