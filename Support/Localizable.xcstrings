    "Mesafeler trackpad genişliğine oranla verilir." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstände sind relativ zur Trackpadbreite angegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distances are relative to the trackpad’s width."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las distancias se indican en proporción al ancho del trackpad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les distances sont relatives à la largeur du trackpad."
          }
        },
