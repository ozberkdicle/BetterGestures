    "Arayüzdeki değişiklikler bu dosyaya yazılır. Dosyayı elle düzenlerseniz \"Yeniden yükle\"ye basın." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen in der Benutzeroberfläche werden in diese Datei geschrieben. Wenn du die Datei manuell bearbeitest, klicke auf „Neu laden“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes you make in the app are saved to this file. If you edit the file manually, click “Reload”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios de la interfaz se guardan en este archivo. Si lo editas a mano, haz clic en «Volver a cargar»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications faites dans l’interface sont enregistrées dans ce fichier. Si vous le modifiez manuellement, cliquez sur « Recharger »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上での変更はこのファイルに書き込まれます。ファイルを手動で編集した場合は「再読み込み」をクリックしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "界面中的更改会写入此文件。如果手动编辑了此文件，请点按“重新载入”。"
          }
        }
      }
    },
